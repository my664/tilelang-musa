   } else {
@@ -205,10 +206,19 @@ ffi::Map<ffi::String, ffi::Any> UpdateMUSAAttrs(ffi::Map<ffi::String, ffi::Any>
     } else {
       archInt = std::stod(version.cast<std::string>()) * 10 + 0.1;
